<!DOCTYPE html>
<html lang="<%= lang %>">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="robots" content="noindex">
    <title>tagd - <%= t('title') %> <%= itemName %></title>
    <link rel="icon" type="image/png" href="/favicon.png">
    <style>
        :root {
            --primary: <%= appearance.primaryColor || '#6b7be5' %>;
            --accent: <%= appearance.accentColor || '#5a6bc4' %>;
        }

        * { margin: 0; padding: 0; box-sizing: border-box; }

        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, 'Helvetica Neue', sans-serif;
            background-color: #1a1a1a;
            color: #e0e0e0;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 72px 20px 20px;
            position: relative;
        }

        .languages { position: absolute; top: 20px; right: 20px; display: flex; gap: 8px; }

        .languages a {
            background-color: #3a3a3a;
            color: #e0e0e0;
            padding: 8px 16px;
            border-radius: 6px;
            font-size: 14px;
            font-weight: 600;
            text-decoration: none;
            transition: background-color 0.2s;
        }

        .languages a:hover { background-color: #4a4a4a; }
        .languages a.active { background-color: var(--primary); color: white; }

        .container {
            max-width: 500px;
            width: 100%;
            background-color: #2a2a2a;
            border-radius: 12px;
            padding: 40px;
            box-shadow: 0 10px 40px rgba(0, 0, 0, 0.5);
            text-align: center;
        }

        .icon { font-size: 64px; margin-bottom: 20px; }
        h1 { font-size: 28px; font-weight: 600; margin-bottom: 16px; color: #fff; }
        .message { font-size: 16px; line-height: 1.6; margin-bottom: 32px; color: #b0b0b0; }

        .info { background-color: #1a1a1a; border-radius: 8px; padding: 24px; margin-bottom: 24px; text-align: left; }
        .info-item + .info-item { margin-top: 16px; }
        .info-label { font-size: 12px; text-transform: uppercase; letter-spacing: 1px; color: #888; margin-bottom: 4px; }
        .info-value { font-size: 16px; color: #e0e0e0; word-break: break-all; }
        .info-value a { color: var(--primary); text-decoration: none; }
        .info-value a:hover { text-decoration: underline; }

        .actions { display: flex; gap: 8px; justify-content: center; flex-wrap: wrap; }

        .cta {
            display: inline-block;
            background-color: var(--primary);
            color: white;
            padding: 12px 32px;
            border-radius: 6px;
            text-decoration: none;
            font-weight: 600;
            transition: background-color 0.2s;
        }

        .cta:hover { background-color: var(--accent); }
        .cta.secondary { background-color: #3a3a3a; color: #e0e0e0; }
        .cta.secondary:hover { background-color: #4a4a4a; }

        footer { font-size: 12px; color: #666; margin-top: 24px; }
        footer a { color: var(--primary); text-decoration: none; }

        @media (max-width: 480px) {
            .container { padding: 28px 20px; }
        }
    </style>
</head>

<body>
    <nav class="languages">
        <% for (const l of languages) { %>
            <a href="?lang=<%= l.code %>" hreflang="<%= l.code %>" <% if (l.code === lang) { %>class="active" aria-current="true"<% } %>><%= l.name %></a>
        <% } %>
    </nav>

    <main class="container">
        <div class="icon">🏷️</div>
        <h1><%= t('title') %> <em><%= itemName %></em></h1>
        <p class="message"><%= t('subtitle') %></p>

        <% if (owner.name || owner.email || website) { %>
        <div class="info">
            <% if (owner.name) { %>
            <div class="info-item">
                <div class="info-label"><%= t('labels.owner') %></div>
                <div class="info-value"><%= owner.name %></div>
            </div>
            <% } %>
            <% if (owner.email) { %>
            <div class="info-item">
                <div class="info-label"><%= t('labels.email') %></div>
                <div class="info-value"><a href="<%= mailto %>"><%= owner.email %></a></div>
            </div>
            <% } %>
            <% if (website) { %>
            <div class="info-item">
                <div class="info-label"><%= t('labels.website') %></div>
                <div class="info-value"><a href="<%= website.url %>" target="_blank" rel="noopener"><%= website.host %></a></div>
            </div>
            <% } %>
        </div>
        <% } %>

        <div class="actions">
            <% if (mailto) { %><a class="cta" href="<%= mailto %>"><%= t('buttons.sendEmail') %></a><% } %>
            <% if (website) { %><a class="cta secondary" href="<%= website.url %>" target="_blank" rel="noopener"><%= t('buttons.visitWebsite') %></a><% } %>
        </div>

        <footer>
            <%= t('poweredBy') %> <a href="https://github.com/stoneset/tagd" target="_blank" rel="noopener"><strong>tagd</strong></a> - <%= t('footer') %>
        </footer>
    </main>
</body>

</html>
