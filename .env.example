PORT=3000

# Required: protects /api/scans. Generate one with: openssl rand -hex 32
ADMIN_TOKEN=

# Reverse proxy in front of tagd (Express "trust proxy" setting):
#   loopback (default)  nginx/Caddy on the same machine
#   2                   Cloudflare -> nginx -> tagd
TRUST_PROXY=loopback

DISCORD_WEBHOOK_URL=

# SMTP password, only used when smtp.enabled is true in config.json
SMTP_PASS=

DEBUG=false
